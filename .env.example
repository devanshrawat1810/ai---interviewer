# AI Interviewer Configuration

# Storage backend: 'json' or 'mongo' (default: json)
STORAGE_BACKEND=json

# MongoDB Settings (used when STORAGE_BACKEND=mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_interviewer

# AI Provider Configuration (Phase 4)
# Provider options: 'openai', 'gemini', 'anthropic', 'mock'
AI_PROVIDER=openai

# API Key for chosen provider (leave empty to run in offline/rule-based fallback mode)
AI_API_KEY=

# Model name (e.g., 'gpt-4o-mini', 'gemini-1.5-flash', 'claude-3-5-sonnet-20241022')
AI_MODEL=gpt-4o-mini

# Base URL override (optional, e.g. for self-hosted LLMs, proxies, or local Ollama)
AI_BASE_URL=

# HTTP Timeout in seconds (default: 30)
AI_TIMEOUT_SECONDS=30

# Maximum AI calls per student per calendar day (default: 30)
AI_DAILY_LIMIT=30
